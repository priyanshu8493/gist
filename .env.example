# Groq API Key - Get your free key at https://console.groq.com/keys
# Copy this file to .env and add your API key
VITE_GROQ_API_KEY=your_api_key_here

# Optional: override the chat model (defaults to openai/gpt-oss-120b)
# Must be a model available on your Groq key: https://console.groq.com/docs/models
VITE_GROQ_MODEL=openai/gpt-oss-120b
